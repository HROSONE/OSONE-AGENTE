{
  "name": "osone-agente",
  "version": "2.0.0",
  "description": "Agente local para assistentes de IA: abre apps, controla mouse e teclado, lê a tela, gerencia janelas e roda PowerShell/terminal no Windows e no Linux. Sem dependências.",
  "type": "commonjs",
  "main": "lib/index.js",
  "bin": {
    "osone-agente": "agente.js"
  },
  "files": [
    "agente.js",
    "lib/",
    "cliente.js",
    "ferramentas.json",
    "painel.html",
    "config.exemplo.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node agente.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "assistente",
    "agente",
    "ia",
    "function-calling",
    "automacao",
    "mouse",
    "teclado",
    "powershell",
    "xdotool",
    "windows",
    "linux"
  ],
  "author": "HROSONE",
  "license": "MIT"
}
